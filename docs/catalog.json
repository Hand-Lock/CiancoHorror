{
  "$comment": "One entry per pack metafile (slug = pack/<dir>/<slug>.pw.toml). `ch doctor` enforces coverage. base=true → comes from the Optimization base (managed by `ch base:sync`). requiredBy lists dependents for libraries.",
  "categories": {
    "base-perf": "Performance mods inherited from the Optimization base pack",
    "horror": "Horror content: stalkers, events, darkness, scarier mobs",
    "sound": "Ambient sound, footsteps, sound physics",
    "golden-days-visuals": "Old-school look: Golden Days RP and the mods it needs (EMF/ETF/ESF/Polytone/Vidalia/Timeless)",
    "voice": "Simple Voice Chat and addons — proximity voice is core to the horror experience",
    "gameplay-qol": "Gameplay and quality-of-life additions",
    "library": "Libraries/APIs required by other mods"
  },
  "mods": {
    "fabric-api": { "category": "library", "base": true, "purpose": "Core Fabric hooks", "why": "Required by nearly every mod", "requiredBy": ["*"] },
