    "forge-config-api-port": { "category": "library", "purpose": "Forge/NeoForge config API on Fabric", "why": "Library", "requiredBy": ["distant-friends", "mutant-monsters", "puzzles-lib"] },
    "geckolib": { "category": "library", "purpose": "Entity animation library", "why": "Library", "requiredBy": ["hollowsteve"] },
    "puzzles-lib": { "category": "library", "purpose": "Fuzs shared library", "why": "Library", "requiredBy": ["mutant-monsters"] },
