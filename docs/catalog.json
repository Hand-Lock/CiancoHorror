    "collective": { "category": "library", "purpose": "Serilum shared library", "why": "Library", "requiredBy": ["giant-spawn", "ore-harvester", "tree-harvester"] },
    "creativecore": { "category": "library", "purpose": "CreativeMD core library", "why": "Library", "requiredBy": ["ambientsounds", "enhancedvisuals"] },
    "data-anchor": { "category": "library", "purpose": "Data attachment/networking library", "why": "Library", "requiredBy": ["enhanced-celestials-2-core", "enhanced-celestials-2-default-lunar-events"] },
