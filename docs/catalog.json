    "lithium": { "category": "base-perf", "base": true, "purpose": "Game-logic optimisation (tick, AI, collisions)", "why": "Server + singleplayer TPS; base pack" },
    "c2me-fabric": { "category": "base-perf", "base": true, "purpose": "Parallel chunk generation/IO", "why": "Chunk performance on the 3-vCPU server; base pack" },
    "ferrite-core": { "category": "base-perf", "base": true, "purpose": "Memory usage reduction", "why": "Base pack; helps the 6 GB server" },
    "modernfix-mvus": { "category": "base-perf", "base": true, "purpose": "Launch time / memory fixes (MVUS fork)", "why": "Base pack" },
    "immediatelyfast": { "category": "base-perf", "base": true, "purpose": "Immediate-mode rendering speedups (HUD, text, maps)", "why": "Base pack" },
    "entityculling": { "category": "base-perf", "base": true, "purpose": "Skip rendering hidden entities/block entities", "why": "Base pack" },
    "moreculling": { "category": "base-perf", "base": true, "purpose": "Extra culling (leaves, item frames, signs)", "why": "Base pack" },
    "obe": { "category": "base-perf", "base": true, "purpose": "Faster block-entity rendering", "why": "Base pack" },
    "asyncparticles": { "category": "base-perf", "base": true, "purpose": "Async particle ticking + GPU particle rendering", "why": "Base pack; horror mods spawn lots of particles" },
    "gnetum": { "category": "base-perf", "base": true, "purpose": "Spread HUD updates over frames", "why": "Base pack" },
